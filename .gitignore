*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env
.env.txt

# ── Storage files — NEVER commit client project data ──────────────────
# Per CLAUDE.md: all storage must be written to LILAMY_DATA_DIR, never
# inside the repository.  Each client deployment has its own data root.
# Pushing one client's data into version control is a confidentiality
# breach and a commercial liability.

# ChromaDB vector stores
.chromadb/
chroma/
chroma.sqlite3

# lilAmy platform data files
.lilamy_registry.db
.lilamy_vision_cache/
.lilamy_graph_token.json

