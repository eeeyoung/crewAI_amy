# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env
.env.txt

# ── Storage files — NEVER commit client project data ──────────────────
# All storage goes to <project_root>/data/ (or LILAMY_DATA_DIR if set).
# Each client deployment has its own data root.  Pushing one client's
# data into version control is a confidentiality breach and a commercial
# liability.

# Primary data directory (local development default)
data/

# Legacy data directory (still used if LILAMY_DATA_DIR points elsewhere)
.crewai/

# ChromaDB vector stores
.chromadb/
chroma/
chroma.sqlite3

# lilAmy platform data files
.lilamy_registry.db
.lilamy_vision_cache/
.lilamy_graph_token.json

# Generic database and binary formats
*.db
*.bin
*.pkl
*.jsonl
*.ost
*.pst
*.vec
*.index
*.sqlite3

# Embedding and index directories
vectordb/
embeddings/
indices/
.knowledge/

# Cache and temporary directories
.cache/

# Training data and knowledge base files (may contain client emails)
knowledge/historical_emails/.chromadb/
tools/amail/knowledge/historical_emails/.chromadb/
tools/amail/historical_emails/.chromadb/
historical_emails/
